{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Color Studio Inventory v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "color",
          "material"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "material": {
            "enum": [
              "pla",
              "matte-pla",
              "silk-pla",
              "pla-cf",
              "petg",
              "matte-petg",
              "metallic-petg",
              "petg-cf",
              "abs",
              "asa",
              "pc",
              "pa",
              "pa-cf",
              "tpu"
            ]
          }
        }
      }
    }
  }
}
